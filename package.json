{
  "name": "seamlint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "slnt": "./dist/cli/slnt.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "pretest": "npm run typecheck && npm run build",
    "test": "node --test",
    "prepare": "npm run build",
    "check:sample": "node ./src/cli/slnt.ts check ./examples/armhole-kink.svg --path body-armhole",
    "check:sample-json": "node ./src/cli/slnt.ts check ./examples/armhole-kink.svg --path body-armhole --json",
    "check:smooth": "node ./src/cli/slnt.ts check ./examples/smooth-join.svg --path front-yoke --compare-to front-panel --expect-smooth",
    "check:smooth-json": "node ./src/cli/slnt.ts check ./examples/smooth-join.svg --path front-yoke --compare-to front-panel --expect-smooth --json",
    "check:gap": "node ./src/cli/slnt.ts check ./examples/endpoint-gap.svg --path upper-seam --compare-to lower-seam --expect-smooth",
    "check:gap-json": "node ./src/cli/slnt.ts check ./examples/endpoint-gap.svg --path upper-seam --compare-to lower-seam --expect-smooth --json",
    "check:open-loop": "node ./src/cli/slnt.ts check ./examples/open-loop.svg --path neckline-loop --closed",
    "check:open-loop-json": "node ./src/cli/slnt.ts check ./examples/open-loop.svg --path neckline-loop --closed --json"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  }
}
